generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  User
  Admin
}

enum JenisLaporan {
  Hilang
  Ditemukan
}

enum StatusLaporan {
  Diterima
  Diproses
  Ditolak
}

model tb_user {
  id              Int         @id @default(autoincrement())
  nama            String      @db.VarChar(50)
  email           String      @unique @db.VarChar(100)
  password        String      @db.VarChar(255)
  role            Role        @default(User)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  laporanDibuat   tb_barang[] @relation("UserReport")
  laporanDikelola tb_barang[] @relation("AdminReport")
}

model tb_barang {
  id         Int           @id @default(autoincrement())
  namabarang String        @db.VarChar(50)
  lokasi     String        @db.VarChar(255)
  notelp     String        @db.VarChar(20)
  deskripsi  String        @db.VarChar(500)
  jenis      JenisLaporan
  status     StatusLaporan
  foto       String?       @db.VarChar(255)
  waktu      DateTime      @default(now())
  userId     Int
  user       tb_user       @relation("UserReport", fields: [userId], references: [id])
  adminId    Int?
  admin      tb_user?      @relation("AdminReport", fields: [adminId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}